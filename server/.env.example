NODE_ENV=development
PORT=4000

# Postgres connection string. When running via docker-compose, host is "postgres";
# when running the server locally with `npm run dev`, use "localhost:5433".
DATABASE_URL=postgresql://vulnscanner:vulnscanner@localhost:5433/vulnscanner

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRES_IN=8h

COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Directory containing .trivyignore/configs — trivy runs with this as cwd so the
# repo's existing .trivyignore is honored. Defaults below are correct for local
# `npm run dev` (cwd is server/); docker-compose overrides both to /app*.
REPO_ROOT=..
REPORTS_DIR=../reports

# Used only by `npm run seed` to create the first admin user.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
