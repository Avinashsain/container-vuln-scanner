# Severity levels that block the build (comma-separated)
FAIL_ON_SEVERITY=LOW,HIGH,CRITICAL
# Where reports are saved
REPORT_DIR=reports
# Skip vulnerabilities that have no fix available yet? (true/false)
IGNORE_UNFIXED=false
# Optional: Slack incoming webhook URL for pass/fail notifications.
# Do NOT commit a real URL here — set it as an environment variable instead,
# e.g. `export SLACK_WEBHOOK_URL=...` or pass it via your CI secrets.
# SLACK_WEBHOOK_URL=