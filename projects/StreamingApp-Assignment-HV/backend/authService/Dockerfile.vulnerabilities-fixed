FROM node:18-alpine AS base

# CVE-2026-31789 (libcrypto3/libssl3, CRITICAL), plus musl/zlib CVEs:
# pull the patched alpine package set instead of what shipped in the layer.
RUN apk update && apk upgrade --no-cache

# Run as a non-root user — the original had no user switch, so the app ran
# as root by default.
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

COPY package*.json ./

RUN npm install --omit=dev

# Requires a .dockerignore in this directory that excludes .env — see the
# adminService fix for why (secrets baked into image layers otherwise).
COPY . .

# CVE-2026-13149/14257 (brace-expansion), CVE-2024-4068 (braces),
# CVE-2024-21538 (cross-spawn), CVE-2025-64756 (glob), CVE-2026-26996/
# 27903/27904 (minimatch), CVE-2026-33671 (picomatch), CVE-2026-48815
# (sigstore), CVE-2026-59873 and friends (tar): once nodemon moves to
# devDependencies (see package.json fix), these mostly disappear from the
# app's own tree. What's left of this family lives under npm's own bundled
# node_modules — remove that tooling since the container never runs npm at
# runtime.
RUN rm -rf \
      /usr/local/lib/node_modules/npm \
      /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/corepack \
      /opt/yarn-v1.22.22 \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg

RUN chown -R appuser:appgroup /app

USER appuser

ENV NODE_ENV=production
EXPOSE 4001

# Was `npm run start` — npm is removed above, so invoke the entry point
# directly, per package.json's "start": "node index.js".
CMD ["node", "index.js"]